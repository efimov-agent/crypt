{
  "name": "feature-scaffold",
  "description": "Adds a new vertical-slice feature (entity, service, minimal API, tests) following HauntedInventory conventions.",
  "prompt": "file://../prompts/feature-scaffold.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "resources": [
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/structure.md",
    "file://.kiro/steering/product.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  },
  "hooks": [
    {
      "name": "test-on-stop",
      "trigger": "Stop",
      "timeout": 600,
      "action": {
        "type": "command",
        "command": "dotnet test HauntedInventory.slnx --nologo -v q 1>&2"
      }
    },
    {
      "name": "guard-migrations",
      "trigger": "PreToolUse",
      "matcher": "^(fs_write|fs_append|str_replace)$",
      "action": {
        "type": "command",
        "command": "sh .kiro/hooks/guard-migrations.sh"
      }
    }
  ]
}
