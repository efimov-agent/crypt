@page "/items"
@using HauntedInventory.Web.Data.Models
@using HauntedInventory.Web.Features.Items
@inject ItemsService ItemsService

<h1>Stock Inventory</h1>

<form method="get" action="/items" class="filter-form">
    <AntiforgeryToken />
    <div class="form-group">
        <input type="checkbox" id="lowStock" name="lowStock" value="true" checked="@LowStock" />
        <label for="lowStock">Show only low stock items</label>
    </div>
    <button type="submit" class="btn">Filter</button>
</form>

@if (_items == null)
{
    <p class="loading">Loading...</p>
}
else if (!_items.Any())
{
    <p class="empty">No items found.</p>
}
else
{
    <table class="items-table">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">SKU</th>
                <th scope="col">Quantity</th>
                <th scope="col">Reorder Level</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td><code>@item.Sku</code></td>
                    <td>@item.Quantity</td>
                    <td>@item.ReorderLevel</td>
                    <td>
                        @if (item.Quantity <= item.ReorderLevel)
                        {
                            <span class="badge badge-low">Low Stock</span>
                        }
                    </td>
                    <td><a href="/items/@item.Id" class="btn-link">View</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [SupplyParameterFromQuery]
    public bool LowStock { get; set; }

    private IReadOnlyList<Item>? _items;

    protected override async Task OnInitializedAsync()
    {
        _items = await ItemsService.GetItemsAsync(lowStockOnly: LowStock, CancellationToken.None);
    }
}